IP=127.0.0.1
PORT=80
DB_ROOT_PASSWORD=password
DB_NAME=wordpress

CAP_SECRET_KEY=secret_key # get from murena

# Outgoing mail. Leave these commented out to catch mail in Mailpit (http://127.0.0.1:8025).
# Uncomment and fill in to send through a real SMTP server instead.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=tls # "tls" for STARTTLS, "ssl" for implicit TLS, empty for none
#SMTP_USER=
#SMTP_PASS=

# Get your current user’s UID and GID
UID=1000 # echo $(id -u)
GID=1000 # echo $(id -g)